# Runtime "database" and seeded/uploaded media — generated at first run,
# not source code. Keeps password hashes and uploaded files out of git.
/data/*.json
/data/.seeded
/storage/movies/videos/*
/storage/movies/thumbs/*
/storage/books/pdfs/*
/storage/books/covers/*
/storage/music/audio/*
/storage/music/covers/*
/storage/bot/
!/storage/**/.htaccess

# OS/editor cruft
.DS_Store
Thumbs.db

# Raspberry Pi image builds (deploy/raspberry-pi/build-image.bat) and the
# login details generated with them.
/dist/

# Browser automation screenshots
/.playwright-mcp/
